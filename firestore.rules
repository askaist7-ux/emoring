rules_version = '2';
// EmoRing Firestore 보안 규칙
// 관리자 역할 = Custom Claims(role) + adminAccess/{uid} 문서(active, role)가 모두 일치할 때만 인정한다.
// 역할·adminAccess는 서버(scripts/set-admin.mjs, Admin SDK)에서만 쓴다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function accessPath() { return /databases/$(database)/documents/adminAccess/$(request.auth.uid); }
    function hasRole(roles) {
      return signedIn()
        && request.auth.token.get('role', '') in roles
        && exists(accessPath())
        && get(accessPath()).data.active == true
        && get(accessPath()).data.role == request.auth.token.role;
    }
    function staffEdit() { return hasRole(['superAdmin', 'operator']); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status == 'active';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // 회원 프로필
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || hasRole(['superAdmin', 'operator']);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'nickname', 'marketing', 'status', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 16
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      // 본인: 닉네임·마케팅 동의만 수정
      allow update: if signedIn() && request.auth.uid == uid
        && changed().hasOnly(['nickname', 'marketing'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 16;
      // 운영진: 계정 상태만 변경. 관리자 계정은 최고 관리자만, 본인은 불가.
      allow update: if staffEdit() && request.auth.uid != uid
        && changed().hasOnly(['status', 'statusReason', 'statusUpdatedBy', 'statusUpdatedAt'])
        && request.resource.data.status in ['active', 'disabled']
        && request.resource.data.statusUpdatedBy == request.auth.uid
        && (resource.data.get('role', 'member') == 'member' || hasRole(['superAdmin']));
      allow delete: if false;
    }

    // 관리자 접근 문서: 본인 확인용 읽기만 허용, 쓰기는 서버만
    match /adminAccess/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 승인작 8종
    match /works/{id} {
      allow read: if true;
      allow create, update: if staffEdit()
        && request.resource.data.status in ['empty', 'review', 'approved', 'onsale', 'hidden']
        && request.resource.data.no is int;
      allow delete: if false;
    }

    // 소식·이벤트
    match /news/{id} {
      allow read: if resource.data.status == 'published' || hasRole(['superAdmin', 'operator', 'viewer']);
      allow create, update: if staffEdit()
        && request.resource.data.type in ['notice', 'release', 'goods', 'event']
        && request.resource.data.status in ['published', 'hidden'];
      allow delete: if false;
    }

    // 팬 라운지
    match /posts/{id} {
      allow read: if resource.data.status == 'published' || staffEdit();
      allow create: if activeMember()
        && request.resource.data.keys().hasOnly(['authorUid', 'author', 'isArtist', 'tag', 'workId', 'title', 'body', 'status', 'reportedBy', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.author == me().nickname
        && request.resource.data.isArtist == (request.auth.token.get('artist', false) == true)
        && request.resource.data.status == 'published'
        && request.resource.data.reportedBy == []
        && request.resource.data.createdAt == request.time
        && request.resource.data.tag in ['자유 이야기', '팬아트', '굿즈 후기', '작가에게 질문']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000;
      // 신고: 로그인 회원이 자기 uid 하나만 추가
      allow update: if activeMember()
        && resource.data.status == 'published'
        && changed().hasOnly(['reportedBy'])
        && !(request.auth.uid in resource.data.get('reportedBy', []))
        && request.resource.data.reportedBy == resource.data.get('reportedBy', []).concat([request.auth.uid]);
      // 운영진: 숨김·복원
      allow update: if staffEdit()
        && changed().hasOnly(['status', 'moderationReason', 'moderatedBy', 'moderatedAt', 'reportedBy'])
        && request.resource.data.status in ['published', 'hidden']
        && request.resource.data.moderatedBy == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      // 댓글: 공개 글에만, 로그인 회원 본인 명의로 작성. 본인 삭제·운영진 숨김.
      match /comments/{cid} {
        allow read: if resource.data.status == 'published' || staffEdit();
        allow create: if activeMember()
          && get(/databases/$(database)/documents/posts/$(id)).data.status == 'published'
          && request.resource.data.keys().hasOnly(['authorUid', 'author', 'isArtist', 'body', 'status', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.author == me().nickname
          && request.resource.data.isArtist == (request.auth.token.get('artist', false) == true)
          && request.resource.data.status == 'published'
          && request.resource.data.createdAt == request.time
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500;
        allow update: if staffEdit()
          && changed().hasOnly(['status', 'moderatedBy', 'moderatedAt'])
          && request.resource.data.status in ['published', 'hidden'];
        allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }
    }

    // 굿즈: 판매 중·품절 상품만 공개. 가격·재고 등록은 운영진.
    match /products/{id} {
      allow read: if resource.data.status in ['onsale', 'soldout'] || staffEdit();
      allow create, update: if staffEdit()
        && request.resource.data.status in ['draft', 'onsale', 'soldout', 'hidden']
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.workIds is list;
      allow delete: if false;
    }

    // 매거진(인터뷰·작업실 이야기·제작 과정)
    match /articles/{id} {
      allow read: if resource.data.status == 'published' || hasRole(['superAdmin', 'operator', 'viewer']);
      allow create, update: if staffEdit()
        && request.resource.data.status in ['draft', 'published', 'hidden']
        && request.resource.data.title is string && request.resource.data.title.size() > 0;
      allow delete: if false;
    }

    // 주문: 검증된 결제 서버만 기록
    match /orders/{id} {
      allow read: if hasRole(['superAdmin', 'finance']);
      allow write: if false;
    }

    // 감사 로그: 관리자 본인 명의로 추가만 가능, 수정·삭제 불가
    match /auditLogs/{id} {
      allow read: if hasRole(['superAdmin']);
      allow create: if hasRole(['superAdmin', 'operator', 'finance', 'viewer'])
        && request.resource.data.keys().hasOnly(['actorUid', 'actor', 'action', 'target', 'outcome', 'at'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
